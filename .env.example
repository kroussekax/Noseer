# canoTe environment template
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit the real .env file — it is gitignored.

# --- Database ---
# Password for the Postgres user created by docker-compose
DB_PASSWORD=change_me

# --- Auth & CORS ---
# Secret key for signing session cookies (minimum 32 characters)
SECRET_KEY=change_me_to_a_secure_random_key_at_least_32_chars

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Set to true when serving behind HTTPS
SECURE_COOKIES=false

# --- AI (OpenRouter) ---
# Server-side only. Never expose this key to the frontend.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vision-language model on OpenRouter (must support image input).
# The ":free" suffix is part of the model id. Free models are rate-limited;
# the API retries automatically and returns HTTP 429 when retries are exhausted.
AI_MODEL=google/gemma-4-26b-a4b-it:free

# Extra models tried in order when AI_MODEL fails (rate limit, outage, bad output).
# Each is a separate capacity pool, so rotation rides out free-tier limits.
# (thinkingmachines inkling models excluded — they 403 for API apps.)
AI_FALLBACK_MODELS=google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
